    <string name="feature_saint_cabrini_name">Saint Frances Xavier Cabrini</string>
    <string name="feature_saint_cabrini_intro">Italian missionary, founder of the Missionary Sisters of the Sacred Heart of Jesus and patroness of migrants. Her life inspires welcome, education and care for those who must start over far from home.</string>
