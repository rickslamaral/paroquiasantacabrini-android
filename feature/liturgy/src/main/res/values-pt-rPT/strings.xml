    <string name="feature_liturgy_mass_part_1_title">Ritos iniciais</string>
    <string name="feature_liturgy_mass_part_1_text">A assembleia reúne-se. Acompanhe o canto de entrada, a saudação, o ato penitencial e a oração inicial.</string>
    <string name="feature_liturgy_mass_part_2_title">Liturgia da Palavra</string>
    <string name="feature_liturgy_mass_part_2_text">Escute as leituras bíblicas, o salmo e o Evangelho. Depois, acompanhe a homilia e a oração dos fiéis.</string>
    <string name="feature_liturgy_mass_part_3_title">Liturgia Eucarística</string>
    <string name="feature_liturgy_mass_part_3_text">Acompanhe a apresentação das ofertas, a oração eucarística e a comunhão. Participe segundo as orientações da comunidade.</string>
    <string name="feature_liturgy_mass_part_4_title">Ritos finais</string>
    <string name="feature_liturgy_mass_part_4_text">A celebração termina com os avisos, a bênção e o envio para viver a fé no dia a dia.</string>
    <string name="feature_liturgy_mass_disclaimer">Roteiro demonstrativo para acompanhar a celebração. Os textos litúrgicos completos devem seguir a edição oficial aprovada pela Igreja.</string>
    <string name="feature_liturgy_daily_title">Liturgia diária</string>
    <string name="feature_liturgy_daily_eyebrow">Oração e Palavra</string>
    <string name="feature_liturgy_daily_banner_description">Missal aberto para a oração e a liturgia</string>
    <string name="feature_liturgy_daily_card_eyebrow">Para rezar hoje</string>
    <string name="feature_liturgy_daily_card_title">A Palavra que reúne a comunidade</string>
    <string name="feature_liturgy_daily_card_note">Conteúdo demonstrativo. As leituras oficiais devem ser consultadas nas publicações litúrgicas da Igreja.</string>
    <string name="feature_liturgy_daily_guide_title">Roteiro de oração</string>
    <string name="feature_liturgy_daily_guide_badge">Leitura guiada</string>
    <string name="feature_liturgy_daily_step_1_title">1 · Preparar o coração</string>
    <string name="feature_liturgy_daily_step_1_text">Encontre um momento de silêncio. Faça o sinal da cruz e peça a Deus que ilumine a sua oração.</string>
    <string name="feature_liturgy_daily_step_2_title">2 · Palavra do dia</string>
    <string name="feature_liturgy_daily_step_2_text">As leituras do dia serão apresentadas aqui quando a paróquia integrar uma fonte litúrgica autorizada.</string>
    <string name="feature_liturgy_daily_step_3_title">3 · A sua intenção</string>
    <string name="feature_liturgy_daily_step_3_text">Apresente a Deus as alegrias, as preocupações e as pessoas que deseja recordar hoje.</string>
    <string name="feature_liturgy_daily_prayer_request">Fazer um pedido de oração</string>
</resources>
