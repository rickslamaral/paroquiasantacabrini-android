    <string name="feature_prayer_rosary_step_1_title">Preparation</string>
    <string name="feature_prayer_rosary_step_1_text">In the name of the Father, and of the Son, and of the Holy Spirit. Amen.

Offering: place this moment of prayer in God\'s hands.</string>
    <string name="feature_prayer_rosary_step_2_title">Creed</string>
    <string name="feature_prayer_rosary_step_2_text">I believe in God, the Father almighty, creator of heaven and earth.</string>
    <string name="feature_prayer_rosary_step_3_title">Our Father</string>
    <string name="feature_prayer_rosary_step_3_text">Our Father, who art in heaven, hallowed be thy name.</string>
    <string name="feature_prayer_rosary_step_4_title">Hail Marys</string>
    <string name="feature_prayer_rosary_step_4_text">Hail Mary, full of grace, the Lord is with thee.</string>
    <string name="feature_prayer_rosary_step_5_title">Glory Be</string>
    <string name="feature_prayer_rosary_step_5_text">Glory be to the Father, and to the Son, and to the Holy Spirit.</string>
    <string name="feature_prayer_rosary_step_6_title">Closing</string>
    <string name="feature_prayer_rosary_step_6_text">Give thanks for this moment and conclude with the sign of the cross.</string>
    <string name="feature_prayer_rosary_mysteries_title">The five Glorious Mysteries</string>
    <string name="feature_prayer_rosary_mystery_1">1 · The Resurrection</string>
    <string name="feature_prayer_rosary_mystery_2">2 · The Ascension</string>
    <string name="feature_prayer_rosary_mystery_3">3 · The Descent of the Holy Spirit</string>
    <string name="feature_prayer_rosary_mystery_4">4 · The Assumption of Mary</string>
    <string name="feature_prayer_rosary_mystery_5">5 · The Coronation of Mary</string>
    <string name="feature_prayer_rosary_disclaimer">Illustrative text, not approved by the parish. Replace it with the approved prayer text before official use.</string>
